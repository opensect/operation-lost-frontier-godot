# Unity -> Godot Y conversion for layout positions. Layout Y values are
# Unity heights (y up, ground top -2.5). Values at or below -2.0 are
# feet positions on/near the ground: the old shift (-1.5) puts them on
# the Godot ground top (-3.5) and is proven by the screenshots.
# Values ABOVE -2.0 are heights above the ground: the old shift put
# them BELOW the ground (platforms at y=-1 landed at -2.5 units, 64 px
# under the ground top, visible as slabs hanging under the dirt; the
# Mission 19 vertical tower's platforms/spawns at y=1..5.5 landed
# underground). For those, flip the height above Unity ground onto
# the Godot ground top: godot_y = -3.5 - (uy + 2.5) = -uy - 6.0.
static func godot_y(unity_y: float) -> float:
	if unity_y <= -2.0:
		return unity_y - 1.5
	return -unity_y - 6.0
