	for c in CHARACTERS:
		if c["id"] == cid: return c
	return CHARACTERS[0]

static func weapon(wid: String) -> Dictionary:
	for w in WEAPONS:
		if w["id"] == wid: return w
	return WEAPONS[0]

static func enemy(eid: String) -> Dictionary:
	for e in ENEMIES:
		if e["id"] == eid: return e
	return ENEMIES[0]

static func boss(bid: String) -> Dictionary:
	for b in BOSSES:
		if b["id"] == bid: return b
	return BOSSES[0]

static func mission(num: int) -> Dictionary:
	for m in MISSIONS:
		if m["number"] == num: return m
	return MISSIONS[0]

static func layout(num: int) -> Dictionary:
	for l in LAYOUTS:
		if l["number"] == num: return l
	return LAYOUTS[0]

static func unlocked_weapons(mission_num: int) -> Array:
	var out: Array = []
	for w in WEAPONS:
		if w["unlock"] <= mission_num: out.append(w["id"])
	return out

static func difficulty_damage(diff: String) -> float:
	match diff:
		"Easy": return 0.7
		"Hard": return 1.15
		"Extreme": return 1.3
	return 1.0

static func enemy_count_multiplier(players: int) -> float:
	if players <= 1: return 1.0
	if players == 2: return 1.4
	if players == 3: return 1.7
	return 2.0

